# GEMINI_API_KEY: Required for Gemini AI API calls (server side only, never put it in front-end code).
# AI Studio injects this at runtime. On Netlify, set it under Site configuration -> Environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (AI Studio / Cloud Run only).
APP_URL="MY_APP_URL"

# --- Netlify only (all optional) -------------------------------------------
# FIREBASE_PROJECT_ID: defaults to the project in firebase-applet-config.json.
# FIREBASE_PROJECT_ID="youthful-kit-0cf5x"

# ALLOWED_EMAIL_DOMAINS: comma-separated list. If set, only these Google accounts may use the AI features.
# ALLOWED_EMAIL_DOMAINS="school.ac.th"

# Override the Gemini models without changing code.
# GEMINI_ANALYSIS_MODEL="gemini-3-flash-preview"
# GEMINI_CHAT_MODEL="gemini-3.5-flash"
